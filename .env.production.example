# ==========================================
# VPS Production Environment Variables
# Copy this file to .env.production on your Vultr server
# ==========================================

# Core Settings
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=INFO
PORT=8000

# Authentication (Must be a long random string)
JWT_SECRET=your_super_secret_jwt_key_here
INTERNAL_TOKEN=your_trusted_worker_secret_here

# Database
# Connect directly to your Supabase PostgreSQL database
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Cloudflare R2 Storage (For reports and PDF assets)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET=your_production_bucket_name

# AI Providers
DEEPSEEK_API_KEY=your_deepseek_api_key
HF_API_TOKEN=your_huggingface_token

# CORS
# Update this to match your actual frontend domain
CORS_ORIGINS=https://gen-rpt-review-frontend.pages.dev

# GitHub Integration
GITHUB_TOKEN=your_github_pat_token
GITHUB_REPO=yt-feng/gen_rpt
BACKEND_URL=https://api.your-vultr-domain.com

# Feature Flags
KNOWLEDGE_ENABLED=true
RAG_ENABLED=true
UPLOAD_ENABLED=true
PROCESSING_ENABLED=true
RETRIEVAL_ENABLED=true
VALIDATION_ENABLED=true
SEARCH_ENABLED=true
