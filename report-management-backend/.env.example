APP_NAME=Report Management Backend
APP_ENV=development
APP_DEBUG=true

HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=REPLACE_WITH_REAL_VALUE

# Supabase
SUPABASE_URL=REPLACE_WITH_REAL_VALUE
SUPABASE_KEY=REPLACE_WITH_REAL_VALUE
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_REAL_VALUE

# R2 Storage
R2_ACCOUNT_ID=REPLACE_WITH_REAL_VALUE
R2_ACCESS_KEY_ID=REPLACE_WITH_REAL_VALUE
R2_SECRET_ACCESS_KEY=REPLACE_WITH_REAL_VALUE
R2_BUCKET=REPLACE_WITH_REAL_VALUE

# Auth
JWT_SECRET=REPLACE_WITH_REAL_VALUE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Redis Cache
REDIS_URL=REPLACE_WITH_REAL_VALUE

# Gateway APIs
OPENAI_API_KEY=REPLACE_WITH_REAL_VALUE
DEEPSEEK_API_KEY=REPLACE_WITH_REAL_VALUE
GROQ_API_KEY=REPLACE_WITH_REAL_VALUE

CORS_ORIGINS=http://localhost:5173

# Publishing
GATEX_BASE_URL=https://dev.gatex.ae/api
GATEX_API_KEY=REPLACE_WITH_REAL_VALUE
GATEX_ENABLE_PUBLISHING=false
GATEX_DEFAULT_COVER_PATH=covers/default.jpg

# GitHub Actions
GITHUB_TOKEN=REPLACE_WITH_REAL_VALUE
